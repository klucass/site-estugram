---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Tela from "../components/Tela.astro";
import SalasDemo from "../components/SalasDemo.astro";
import CheckinCard from "../components/CheckinCard.astro";
import RankingDemo from "../components/RankingDemo.astro";
import { signupUrl, contatoEmail, oficiais } from "../config";

// Título do herói, palavra por palavra, para a entrada em sequência.
const titulo =
  "Estude com os amigos ao vivo, dispute o ranking e veja sua evolução.".split(
    " ",
  );

const passos = [
  {
    titulo: "Entre num desafio",
    texto:
      "Escolha um desafio ou clube oficial do Estugram, como o Clube dos Corujas, ou crie um com os seus amigos.",
  },
  {
    titulo: "Sente na sala",
    texto:
      "Todo desafio tem uma sala de estudo. Você senta numa mesa e o timer começa; levantou, ele pausa.",
  },
  {
    titulo: "Ligue a câmera",
    texto:
      "Entre na chamada e estude vendo os outros estudarem. Fica todo mundo em silêncio, cada um no seu material.",
  },
];

const motivos = [
  {
    id: "silencio",
    titulo: "Em silêncio, mas acompanhado",
    texto:
      "Cada um na sua casa, com a câmera ligada e o microfone desligado. Ver outras pessoas estudando ajuda a sentar e a continuar.",
  },
  {
    id: "caderno",
    titulo: "Câmera no caderno vale",
    texto:
      "Muita gente aponta a câmera só para o caderno. Quem prefere não aparecer fica com o rosto do boneco no quadro.",
  },
  {
    id: "controle",
    titulo: "Você entra com tudo desligado",
    texto:
      "A câmera e o microfone só ligam quando você quiser. Dá para abrir o microfone no intervalo para tirar uma dúvida.",
  },
  {
    id: "timer",
    titulo: "Seu tempo conta sozinho",
    texto:
      "Cada sessão na sala vira um registro com matéria e tempo, e entra no ranking do desafio.",
  },
];

// Mosaico da seção "Estudar junto por vídeo": câmeras no caderno e bonecos de quem não ligou.
const mosaico = [
  { nome: "Camila", foto: "caderno-caneta", alt: "mão escrevendo num caderno", tempo: "1h 12" },
  { nome: "Rafael", rosto: "rafael", tempo: "48 min" },
  { nome: "Larissa", foto: "caneta-vermelha", alt: "caneta vermelha sobre o caderno", tempo: "2h 05" },
  { nome: "Bianca", foto: "marca-texto", alt: "marca-texto grifando uma apostila", tempo: "35 min" },
  { nome: "Thiago", rosto: "thiago", tempo: "1h 30" },
  { nome: "Nina", foto: "caderno-aberto", alt: "caderno aberto com caneta", tempo: "20 min" },
];

const ferramentas = [
  {
    nome: "Timer",
    titulo: "Cronometre suas sessões",
    texto: "Use o cronômetro ou o pomodoro, na sala ou fora dela.",
    tela: "timer",
    alt: "Timer do Estugram em modo cronômetro, com os botões Pausar e Finalizar e registrar",
  },
  {
    nome: "Ciclo",
    titulo: "Monte seu ciclo de estudo",
    texto:
      "Defina a ordem das matérias e o tempo de cada uma, e veja o que vem a seguir.",
    tela: "ciclo",
    alt: "Ciclo de estudo com 63% da volta feita: Português, Direito Constitucional e Administrativo concluídos, Raciocínio Lógico como próxima",
    pro: true,
  },
  {
    nome: "Revisões",
    titulo: "Volte a cada conteúdo na hora certa",
    texto:
      "Agende as revisões no calendário e receba sugestões quando errar muito num assunto.",
    tela: "revisoes",
    alt: "Lista de revisões atrasadas, de hoje e de amanhã, com calendário de outubro ao lado",
    pro: true,
  },
  {
    nome: "Estatísticas",
    titulo: "Veja como anda a preparação",
    texto:
      "Horas e taxa de acerto por matéria, dias com estudo e horários em que você mais rende.",
    tela: "estatisticas",
    alt: "Estatísticas de 30 dias: 83 horas estudadas, constância de 25 dias, 1.460 questões com 78% de acerto e desempenho por matéria",
    pro: true,
  },
];

const perguntas = [
  {
    p: "Preciso pagar?",
    r: "Não. Entrar em desafios, estudar na sala, usar a chamada e participar do ranking é grátis. O Pro tem ferramentas de planejamento, como ciclo de estudos, revisões e estatísticas.",
  },
  {
    p: "Como eu entro numa sala?",
    r: `A sala faz parte de um desafio: quem participa do desafio entra na sala dele. Você pode entrar num desafio ou clube oficial do Estugram, como ${oficiais.join(" e ")}, ou criar um desafio e convidar os amigos.`,
  },
  {
    p: "Sou obrigado a ligar a câmera?",
    r: "Não. Você entra na chamada com a câmera e o microfone desligados e liga só o que quiser. Sem câmera, aparece o rosto do seu boneco no quadro. E dá para ficar na sala sem entrar na chamada.",
  },
  {
    p: "As pessoas ficam conversando na chamada?",
    r: "Em geral, não. A chamada é para estudar junto em silêncio, com o microfone desligado. A conversa fica no chat da sala e nos intervalos.",
  },
  {
    p: "Posso estudar só com os meus amigos?",
    r: "Pode. Crie um desafio, mande o link ou o código no grupo e a sala fica só para vocês, com chamada, ranking de estudo e um feed com o que cada um fez no dia.",
  },
  {
    p: "Como o tempo de estudo é contado?",
    r: "Quando você senta numa mesa, o timer começa. Se levantar, ele pausa. No fim, você registra a sessão com a matéria, e ela entra no seu histórico e no ranking do desafio.",
  },
  {
    p: "Funciona no celular?",
    r: "Funciona no navegador do celular e do computador, sem instalar nada.",
  },
];

const seta = "→";
---

<Base
  title="Estugram · estude junto, com a câmera ligada"
  description="Sala de estudo online com câmera: cada um na sua casa, em silêncio, vendo os outros estudarem. Entre num desafio oficial ou crie um com os amigos. Grátis, no navegador."
>
  <Header />

  <main id="conteudo">
    <!-- Herói -->
    <section class="hero">
      <div class="aurora" aria-hidden="true">
        <i class="a1"></i>
        <i class="a2"></i>
        <i class="a3"></i>
      </div>
      <div class="grade" aria-hidden="true"></div>

      <div class="wrap">
        <div class="hero-copy">
          <a class="selo entra" href="#sala" style="--t:0.05s">
            <span class="novo">Novo</span>
            Câmera e microfone na sala de estudo
            <span class="seta" aria-hidden="true">
              {seta}
            </span>
          </a>
          <h1>
            {titulo.map((w, i) => (
              <>
                <span class="w">
                  <span style={`--i:${i}`}>{w}</span>
                </span>{" "}
              </>
            ))}
          </h1>
          <p class="lead entra" style="--t:0.6s">
            Entre num desafio de estudo, sente na sala e ligue a câmera. Cada um
            na sua casa, em silêncio, vendo os outros estudarem. A câmera pode
            ficar só no caderno.
          </p>
          <div class="hero-ctas entra" style="--t:0.75s">
            <a class="btn btn-primary" href={signupUrl("hero")} data-cta-principal>
              Estudar junto agora{" "}
              <span class="seta" aria-hidden="true">
                {seta}
              </span>
            </a>
            <a class="btn btn-ghost" href="#grupo">
              Criar um desafio com amigos
            </a>
          </div>
          <ul class="garantias entra" style="--t:0.85s">
            <li>Grátis</li>
            <li>Câmera no rosto, no caderno ou desligada</li>
            <li>Direto no navegador</li>
          </ul>
        </div>

        <div class="hero-demo entra-visual" id="salas">
          <div class="brilho" aria-hidden="true"></div>
          <SalasDemo />
        </div>
      </div>
    </section>

    <!-- Como funciona -->
    <section class="section" id="como-funciona">
      <div class="wrap">
        <div class="section-head centro" data-reveal>
          <span class="eyebrow">Como funciona</span>
          <h2>Do link à mesa em três passos.</h2>
        </div>
        <ol class="passos">
          {passos.map((p, i) => (
            <li class="passo card spot" data-reveal style={`--d:${i}`}>
              <span class="num tnum" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Por que a sala -->
    <section class="section alt" id="sala">
      <div class="wrap">
        <div class="section-head centro" data-reveal>
          <span class="eyebrow">Estudar junto por vídeo</span>
          <h2>Cada um na sua casa, todo mundo estudando.</h2>
          <p>
            É como dividir a mesa da biblioteca: ninguém conversa, mas você vê
            que não está sozinho.
          </p>
        </div>

        <div class="mosaico" data-reveal="scale" aria-label="Quadros de câmera de uma chamada de estudo">
          {mosaico.map((q) => (
            <figure class:list={["janela", { ligada: !!q.foto }]}>
              {q.foto ? (
                <img src={`/salas/cameras/${q.foto}.webp`} width="480" height="300" alt={`Câmera de ${q.nome}: ${q.alt}`} loading="lazy" decoding="async" />
              ) : (
                <img class="rosto" src={`/salas/rostos/${q.rosto}.svg`} width="84" height="84" alt={`${q.nome} com a câmera desligada, aparecendo como boneco`} loading="lazy" decoding="async" />
              )}
              <figcaption>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path d="M9 9v3a3 3 0 0 0 5 2.2M15 10V6a3 3 0 0 0-5.7-1.3M5 11a7 7 0 0 0 11.5 5.4M19 11a7 7 0 0 1-.6 2.8M12 18v3M4 4l16 16" />
                </svg>
                {q.nome}
                {q.tempo && <span class="tnum">{q.tempo}</span>}
              </figcaption>
            </figure>
          ))}
        </div>

        <ul class="motivos">
          {motivos.map((m, i) => (
            <li class="motivo card spot" id={m.id} data-reveal style={`--d:${i}`}>
              <span class:list={["motivo-ic", m.id]} aria-hidden="true">
                {m.id === "silencio" && (
                  <svg viewBox="0 0 24 24" width="24" height="24">
                    <path d="M3 8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2ZM15 10.5l5-3v9l-5-3" />
                  </svg>
                )}
                {m.id === "caderno" && (
                  <svg viewBox="0 0 24 24" width="24" height="24">
                    <path d="M6 3h11a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6ZM6 3v18M3 7h3M3 12h3M3 17h3M10 8h5M10 12h5" />
                  </svg>
                )}
                {m.id === "controle" && (
                  <svg viewBox="0 0 24 24" width="24" height="24">
                    <path d="M9 9v3a3 3 0 0 0 5 2.2M15 10V6a3 3 0 0 0-5.7-1.3M5 11a7 7 0 0 0 11.5 5.4M19 11a7 7 0 0 1-.6 2.8M12 18v3M4 4l16 16" />
                  </svg>
                )}
                {m.id === "timer" && (
                  <svg viewBox="0 0 24 24" width="24" height="24">
                    <circle cx="12" cy="13" r="8" />
                    <path d="M12 9v4l2.5 2M9 2h6" />
                  </svg>
                )}
              </span>
              <h3>
                {m.titulo}
              </h3>
              <p>{m.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Sala do grupo: desafio, feed e ranking -->
    <section class="section" id="grupo">
      <div class="wrap">
        <div class="grupo-topo">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Para a sua turma</span>
            <h2>Chame os amigos para um desafio só de vocês.</h2>
            <p>
              Mande o link no grupo do WhatsApp. O desafio já vem com sala e
              chamada, um ranking de quem estudou e um feed com o que cada um
              fez no dia.
            </p>
            <div class="grupo-cta">
              <a class="btn btn-primary" href={signupUrl("grupo")}>
                Criar um desafio{" "}
                <span class="seta" aria-hidden="true">
                  {seta}
                </span>
              </a>
              <a class="btn btn-ghost" href={signupUrl("grupo-codigo")}>
                Tenho um código
              </a>
            </div>
          </div>
        </div>

        <div class="showcase">
          <div class="feed" data-reveal style="--d:1">
            <CheckinCard
              nome="Ana Souza"
              ini="AS"
              cor="#6A4C93"
              quando="há 12 min · Biblioteca Central"
              pontos="+3,3 h"
              tempo="3h 20m"
              materia="Português"
              materiaCor="#14B8B8"
              questoes="60 questões · 88%"
              legenda="Manhã inteira de interpretação de texto. Crase ainda me pega!"
              cafes={9}
              comentarios={4}
              fotoBg="#4A5568"
              fotoAlt="Foto do check-in de Ana: caderno aberto e caneca na mesa"
            />
            <p class="dica">
              <span aria-hidden="true">↑</span> Experimente mandar um cafezinho
            </p>
          </div>
          <div class="rank-col">
            <RankingDemo />
          </div>
        </div>
      </div>
    </section>

    <!-- Ferramentas do app, em abas -->
    <section class="section alt" id="organizacao">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Seus estudos organizados</span>
          <h2>O que você estuda fica registrado.</h2>
          <p>
            Dá para ver como anda a preparação. No Pro, o ciclo, as revisões e
            as estatísticas ajudam a planejar os próximos dias.
          </p>
        </div>

        <div class="vitrine" data-vitrine data-reveal="scale">
          <div class="abas" role="tablist" aria-label="Ferramentas do app">
            {ferramentas.map((f, i) => (
              <button
                type="button"
                role="tab"
                class="aba"
                id={`aba-${f.tela}`}
                aria-controls={`painel-${f.tela}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="aba-topo">
                  <span class="aba-nome">{f.nome}</span>
                  {f.pro && <span class="pro">Pro</span>}
                </span>
                <span class="aba-corpo">
                  <span>
                    <b>{f.titulo}</b>
                    {f.texto}
                  </span>
                </span>
                <span class="aba-tempo" aria-hidden="true">
                  <i />
                </span>
              </button>
            ))}
          </div>
          <div class="paineis">
            {ferramentas.map((f, i) => (
              <div
                role="tabpanel"
                class:list={["painel", { ativo: i === 0 }]}
                id={`painel-${f.tela}`}
                aria-labelledby={`aba-${f.tela}`}
                inert={i !== 0}
              >
                <Tela nome={f.tela} tipo="auto" alt={f.alt} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Perguntas -->
    <section class="section" id="perguntas">
      <div class="wrap faq-grid">
        <div class="section-head" data-reveal>
          <span class="eyebrow">Perguntas frequentes</span>
          <h2>Dúvidas antes de entrar?</h2>
          <p>
            Se a sua não estiver aqui, escreva para{" "}
            <a href={`mailto:${contatoEmail}`}>{contatoEmail}</a>.
          </p>
        </div>
        <div class="faq">
          {perguntas.map((q, i) => (
            <details data-reveal style={`--d:${i % 4}`}>
              <summary>{q.p}</summary>
              <p>{q.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA final -->
    <section class="final">
      <div class="final-brilho" aria-hidden="true"></div>
      <div class="wrap final-in">
        <h2 data-reveal="blur" style="--d:1">
          Tem gente estudando agora. Senta com a gente.
        </h2>
        <p data-reveal style="--d:2">
          Entre num desafio, abra a sala e comece a sessão de hoje.
        </p>
        <div class="hero-ctas" data-reveal style="--d:3">
          <a class="btn btn-primary" href={signupUrl("final")}>
            Estudar junto agora{" "}
            <span class="seta" aria-hidden="true">
              {seta}
            </span>
          </a>
          <a class="btn btn-ghost" href={signupUrl("final-grupo")}>
            Criar um desafio com amigos
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- No celular, o botão principal acompanha a rolagem depois do herói -->
  <div class="fixo" data-fixo hidden>
    <a class="btn btn-primary" href={signupUrl("fixo")}>
      Estudar junto agora{" "}
      <span class="seta" aria-hidden="true">
        {seta}
      </span>
    </a>
  </div>

  <Footer />
</Base>

<script>
  const calmo = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Botão fixo do celular: aparece quando o botão do herói sai da tela e some no fim da página
  const fixo = document.querySelector<HTMLElement>("[data-fixo]");
  const principal = document.querySelector("[data-cta-principal]");
  const fim = document.querySelector(".final");
  if (fixo && principal && fim) {
    let passou = false;
    let noFim = false;
    const atualizar = () => (fixo.hidden = !(passou && !noFim));
    new IntersectionObserver(([e]) => {
      passou = !e.isIntersecting && e.boundingClientRect.top < 0;
      atualizar();
    }).observe(principal);
    new IntersectionObserver(([e]) => {
      noFim = e.isIntersecting;
      atualizar();
    }).observe(fim);
  }

  // Vitrine de ferramentas: abas que trocam sozinhas, com barra de tempo
  const vitrine = document.querySelector<HTMLElement>("[data-vitrine]");
  if (vitrine) {
    const abas = [...vitrine.querySelectorAll<HTMLButtonElement>(".aba")];
    const paineis = [...vitrine.querySelectorAll<HTMLElement>(".painel")];
    let atual = 0;

    const mostrar = (n: number, foco = false) => {
      atual = (n + abas.length) % abas.length;
      abas.forEach((a, i) => {
        const sim = i === atual;
        a.setAttribute("aria-selected", String(sim));
        a.tabIndex = sim ? 0 : -1;
      });
      paineis.forEach((p, i) => {
        p.classList.toggle("ativo", i === atual);
        p.inert = i !== atual;
      });
      if (foco) abas[atual].focus();
    };

    abas.forEach((a, i) => {
      a.addEventListener("click", () => mostrar(i));
      a.addEventListener("keydown", (ev) => {
        const mapa: Record<string, number> = {
          ArrowDown: atual + 1,
          ArrowRight: atual + 1,
          ArrowUp: atual - 1,
          ArrowLeft: atual - 1,
          Home: 0,
          End: abas.length - 1,
        };
        if (ev.key in mapa) {
          ev.preventDefault();
          mostrar(mapa[ev.key], true);
        }
      });
      // Quando a barra de tempo da aba ativa termina, passa para a próxima
      a.querySelector("i")!.addEventListener("animationend", () =>
        mostrar(i + 1),
      );
    });

    if (!calmo) {
      // Só corre enquanto a vitrine está visível
      new IntersectionObserver(
        ([e]) => vitrine.classList.toggle("tocando", e.isIntersecting),
        { threshold: 0.35 },
      ).observe(vitrine);
    }
  }
</script>

<style>
  /* ---------- Herói ---------- */
  .hero {
    position: relative;
    padding: clamp(36px, 5vw, 72px) 0 clamp(64px, 8vw, 112px);
    margin-top: -72px;
    padding-top: calc(72px + clamp(24px, min(5vw, 4.5vh), 72px));
    overflow: hidden;
    isolation: isolate;
  }
  .aurora {
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
  }
  .aurora i {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
    animation: deriva 22s ease-in-out infinite alternate;
  }
  .a1 {
    width: 620px;
    height: 420px;
    left: 50%;
    top: 34%;
    margin-left: -560px;
    background: rgb(91 140 255 / 0.32);
  }
  .a2 {
    width: 520px;
    height: 380px;
    left: 50%;
    top: 40%;
    margin-left: 40px;
    background: rgb(255 77 138 / 0.16);
    animation-delay: -8s;
  }
  .a3 {
    width: 700px;
    height: 300px;
    left: 50%;
    top: 4%;
    margin-left: -350px;
    background: rgb(0 209 209 / 0.08);
    animation-delay: -14s;
  }
  @keyframes deriva {
    from {
      translate: 0 0;
      scale: 1;
    }
    to {
      translate: 60px -40px;
      scale: 1.15;
    }
  }
  .grade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center top;
    mask-image: radial-gradient(
      ellipse 70% 55% at 50% 18%,
      #000 10%,
      transparent 75%
    );
  }

  .hero-copy {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 2.4vh, 22px);
    max-width: 1040px;
    margin: 0 auto;
    text-align: center;
  }
  .selo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 14px 5px 5px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgb(24 28 37 / 0.6);
    backdrop-filter: blur(8px);
    color: var(--muted-2);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.3s ease,
      color 0.3s ease;
  }
