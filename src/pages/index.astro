<script>
  const calmo = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Como funciona: o passo no meio da tela escolhe qual print aparece ao lado
  const historia = document.querySelector<HTMLElement>("[data-historia]");
  if (historia) {
    const passos = [...historia.querySelectorAll<HTMLElement>(".passo")];
    const cenas = [...historia.querySelectorAll<HTMLElement>(".cena")];
    const ativar = (n: number) => {
      passos.forEach((p, i) => p.classList.toggle("ativo", i === n));
      cenas.forEach((c, i) => c.classList.toggle("ativa", i === n));
    };
    const meio = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) ativar(passos.indexOf(e.target as HTMLElement));
        }
      },
      { rootMargin: "-50% 0px -50% 0px" },
    );
    passos.forEach((p) => meio.observe(p));

    // Linha de progresso ao lado dos passos
    const lista = historia.querySelector<HTMLElement>(".passos")!;
    let agendado = false;
    const medir = () => {
      agendado = false;
      const r = lista.getBoundingClientRect();
      const p = (innerHeight * 0.5 - r.top) / r.height;
      lista.style.setProperty("--prog", String(Math.max(0, Math.min(1, p))));
    };
    addEventListener(
      "scroll",
      () => {
        if (!agendado) {
          agendado = true;
          requestAnimationFrame(medir);
        }
      },
      { passive: true },
    );
    medir();
  }

  // Vitrine de ferramentas: abas que trocam sozinhas, com barra de tempo
  const vitrine = document.querySelector<HTMLElement>("[data-vitrine]");
  if (vitrine) {
    const abas = [...vitrine.querySelectorAll<HTMLButtonElement>(".aba")];
    const paineis = [...vitrine.querySelectorAll<HTMLElement>(".painel")];
    let atual = 0;

    const mostrar = (n: number, foco = false) => {
      atual = (n + abas.length) % abas.length;
      abas.forEach((a, i) => {
        const sim = i === atual;
        a.setAttribute("aria-selected", String(sim));
        a.tabIndex = sim ? 0 : -1;
      });
      paineis.forEach((p, i) => {
        p.classList.toggle("ativo", i === atual);
        p.inert = i !== atual;
      });
      if (foco) abas[atual].focus();
    };

    abas.forEach((a, i) => {
      a.addEventListener("click", () => mostrar(i));
      a.addEventListener("keydown", (ev) => {
        const mapa: Record<string, number> = {
          ArrowDown: atual + 1,
          ArrowRight: atual + 1,
          ArrowUp: atual - 1,
          ArrowLeft: atual - 1,
          Home: 0,
          End: abas.length - 1,
        };
        if (ev.key in mapa) {
          ev.preventDefault();
          mostrar(mapa[ev.key], true);
        }
      });
      // Quando a barra de tempo da aba ativa termina, passa para a próxima
      a.querySelector("i")!.addEventListener("animationend", () =>
        mostrar(i + 1),
      );
    });

    if (!calmo) {
      // Só corre enquanto a vitrine está visível
      new IntersectionObserver(
        ([e]) => vitrine.classList.toggle("tocando", e.isIntersecting),
        { threshold: 0.35 },
      ).observe(vitrine);
    }
  }
</script>

