---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { redes } from '../config';

interface Props {
  title: string;
  description: string;
  /** Imagem de prévia do link. Sem ela, vale public/og.jpg. */
  imagem?: string;
  /** Tamanho real da imagem em pixels. O padrão é o de public/og.jpg. */
  imagemLargura?: number;
  imagemAltura?: number;
  tipo?: 'website' | 'article';
}

const {
  title,
  description,
  imagem = '/og.jpg',
  imagemLargura = 1200,
  imagemAltura = 630,
  tipo = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagemUrl = new URL(imagem, Astro.site).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E1117" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Blog do Estugram" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="font" type="font/otf" href="/fonts/tt-commons-regular.otf" crossorigin />

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Estugram" />
    <meta property="og:image" content={imagemUrl} />
    <meta property="og:image:secure_url" content={imagemUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <!-- Sem largura e altura, o Facebook/WhatsApp não mostra a imagem na primeira vez que lê o link. -->
    <meta property="og:image:width" content={String(imagemLargura)} />
    <meta property="og:image:height" content={String(imagemAltura)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${redes.twitter.usuario}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagemUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap"
    />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <slot />
    <script>
      import '../scripts/movimento';
    </script>
  </body>
</html>
