---
// Artigo na lista do blog. Com `destaque`, ocupa a linha inteira com a capa ao lado.
import { Image } from 'astro:assets';
import { formatarData, minutosDeLeitura, type Post } from '../lib/blog';

interface Props {
  post: Post;
  destaque?: boolean;
  /** A primeira capa da página carrega na hora, as outras só quando chegam perto da tela. */
  prioridade?: boolean;
}

const { post, destaque = false, prioridade = false } = Astro.props;
const { titulo, descricao, capa, capaAlt, data } = post.data;
---

<article class:list={['post card spot', { destaque }]}>
  <div class="capa">
    <Image
      src={capa}
      alt={capaAlt}
      widths={[400, 720, 1100]}
      sizes={destaque ? '(max-width: 900px) 100vw, 640px' : '(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 380px'}
      loading={prioridade ? 'eager' : 'lazy'}
      fetchpriority={prioridade ? 'high' : 'auto'}
    />
  </div>
  <div class="corpo">
    <h2>
      <a href={`/blog/${post.id}`}>{titulo}</a>
    </h2>
    <p class="descricao">{descricao}</p>
    <p class="meta">
      {data && <time datetime={data.toISOString()}>{formatarData(data)}</time>}
      <span>{minutosDeLeitura(post)} min de leitura</span>
    </p>
  </div>
</article>

<style>
  .post {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    transition:
      translate 0.5s var(--ease-out),
      border-color 0.3s ease;
  }
  .post:hover {
    translate: 0 -4px;
    border-color: var(--line-2);
  }
  .capa {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--card-2);
  }
  .capa img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.9s var(--ease-out);
  }
  .post:hover .capa img {
    scale: 1.04;
  }
  .corpo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 24px;
  }
  h2 {
    font-size: 22px;
    font-stretch: 110%;
    font-weight: 800;
    line-height: 1.15;
  }
  /* O link cobre o cartão inteiro */
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .post:has(a:focus-visible) {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }
  h2 a:focus-visible {
    outline: none;
  }
  .descricao {
    color: var(--muted-2);
    font-size: 16px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: auto;
    padding-top: 8px;
    color: var(--muted);
    font-size: 14px;
  }

  .destaque {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }
  .destaque .capa {
    aspect-ratio: auto;
    min-height: 340px;
  }
  .destaque .corpo {
    justify-content: center;
    gap: 16px;
    padding: clamp(28px, 4vw, 48px);
  }
  .destaque h2 {
    font-size: clamp(26px, 3vw, 36px);
    font-stretch: 120%;
    font-weight: 900;
  }
  .destaque .descricao {
    font-size: 17px;
    -webkit-line-clamp: 4;
  }
  .destaque .meta {
    margin-top: 0;
  }
  @media (max-width: 900px) {
    .destaque {
      display: flex;
    }
    .destaque .capa {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
  }
</style>
