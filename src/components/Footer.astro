---
import { contatoEmail, redes } from '../config';
---

<footer class="foot">
  <div class="wrap foot-in">
    <a class="brand" href="/" aria-label="Estugram, início">
      <img src="/estugram-logo-branca.png" width="528" height="92" alt="estugram" />
    </a>
    <nav aria-label="Links do rodapé">
      <a href="/blog">Blog</a>
      <a href="/termos">Termos</a>
      <a href="/privacidade">Privacidade</a>
      <a href={`mailto:${contatoEmail}`}>Contato</a>
    </nav>
    <div class="redes">
      <a href={redes.instagram.url} target="_blank" rel="noopener" aria-label={`Instagram do Estugram (@${redes.instagram.usuario})`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle></svg>
      </a>
      <a href={redes.twitter.url} target="_blank" rel="noopener" aria-label={`X (Twitter) do Estugram (@${redes.twitter.usuario})`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z"></path></svg>
      </a>
    </div>
    <span class="copy">© {new Date().getFullYear()} Estugram</span>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding: 28px 0;
    font-size: 14px;
    color: var(--muted);
  }
  .foot-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .brand img {
    height: 22px;
    width: auto;
  }
  nav {
    display: flex;
    gap: 18px;
  }
  nav a {
    color: var(--muted-2);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  nav a:hover {
    color: var(--text);
  }
  .redes {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }
  .redes a {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    color: var(--muted-2);
    transition: color 0.3s ease, background 0.3s ease;
  }
  .redes a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }
  @media (max-width: 560px) {
    .redes {
      margin-left: 0;
    }
  }
</style>
