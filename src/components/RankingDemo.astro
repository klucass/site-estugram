---
// Dados de exemplo do protótipo: Maratona TRF Outubro, Lucas em 6º de 18.
type Linha = { pos: string; ini: string; nome: string; valor: string; bg: string; delta: string; tom?: 'up' | 'down' | 'me' };
type Podio = { pos: string; ini: string; nome: string; valor: string; bg: string; medalha: string; h: number; size: number };

const ranking: { podio: Podio[]; linhas: Linha[] } = {
  podio: [
    { pos: '2', ini: 'RL', nome: 'Rafael Lima', valor: '58h 05m', bg: '#3F6E5A', medalha: 'var(--silver)', h: 70, size: 52 },
    { pos: '1', ini: 'JP', nome: 'Juliana Prado', valor: '64h 20m', bg: '#8A5A44', medalha: 'var(--gold)', h: 96, size: 64 },
    { pos: '3', ini: 'AS', nome: 'Ana Souza', valor: '55h 40m', bg: '#6A4C93', medalha: 'var(--bronze)', h: 54, size: 52 },
  ],
  linhas: [
    { pos: '4', ini: 'PN', nome: 'Pedro Nunes', valor: '52h 10m', bg: '#4D5B73', delta: '▲ 1 hoje', tom: 'up' },
    { pos: '5', ini: 'CD', nome: 'Carla Dias', valor: '50h 40m', bg: '#7A5C2E', delta: '▼ 1 hoje', tom: 'down' },
    { pos: '6', ini: 'LA', nome: 'Você', valor: '41h 25m', bg: '#2F5FE0', delta: 'faltam 9h 15m para o 5º', tom: 'me' },
    { pos: '7', ini: 'MT', nome: 'Marcos Teixeira', valor: '41h 20m', bg: '#5A6B3D', delta: 'sem mudança' },
  ],
};
---

<div class="ranking card" data-reveal="fade">
  <b class="ranking-title">Ranking de estudos · individual</b>
  <div class="painel">
    <div class="podio">
      {ranking.podio.map((p, i) => (
        <div class="degrau" style={`--i:${i}`}>
          <span class="avatar" style={`width:${p.size}px;height:${p.size}px;background:${p.bg};border:3px solid ${p.medalha}`}>{p.ini}</span>
          <b>{p.nome}</b>
          <small class="tnum">{p.valor}</small>
          <div class="base" style={`--h:${p.h}px;border-top-color:${p.medalha};color:${p.medalha}`}>{p.pos}</div>
        </div>
      ))}
    </div>
    <ol>
      {ranking.linhas.map((l, i) => (
        <li class={l.tom === 'me' ? 'me' : ''} style={`--i:${i}`}>
          <span class="n tnum">{l.pos}</span>
          <span class="avatar" style={`background:${l.bg}`}>{l.ini}</span>
          <span class="nome">
            <b>{l.nome}</b>
            <small class={l.tom}>{l.delta}</small>
          </span>
          <b class="tnum">{l.valor}</b>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .ranking {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    width: 100%;
  }
  .ranking-title {
    font-size: 15px;
  }
  .painel {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .podio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    align-items: end;
  }
  .degrau {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }
  .degrau b {
    font-size: 13px;
    line-height: 1.2;
    margin-top: 2px;
  }
  .degrau small {
    font-size: 12px;
    color: var(--muted-2);
  }
  .base {
    height: var(--h);
    overflow: hidden;
    width: 100%;
    margin-top: 4px;
    background: var(--bg);
    border-radius: 14px 14px 0 0;
    border-top: 4px solid;
    display: flex;
    justify-content: center;
    padding-top: 8px;
    font-size: 28px;
    font-weight: 900;
    font-stretch: 125%;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 16px;
    background: var(--bg);
    border: 1px solid var(--bg);
  }
  li.me {
    background: var(--blue-soft);
    border-color: var(--blue);
    box-shadow: 0 0 0 4px rgb(91 140 255 / 0.12);
  }

  /* Pódio sobe e a lista entra em sequência quando o ranking aparece */
  :global(.js) .base {
    height: 8px;
    transition: height 1.1s var(--ease-out);
    transition-delay: calc(0.25s + var(--i) * 0.12s);
  }
  :global(.js) .degrau .avatar,
  :global(.js) .degrau b,
  :global(.js) .degrau small {
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.8s var(--ease-out),
      translate 0.8s var(--ease-out);
    transition-delay: calc(0.7s + var(--i) * 0.12s);
  }
  :global(.js) li {
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity 0.7s var(--ease-out),
      translate 0.7s var(--ease-out);
    transition-delay: calc(0.5s + var(--i) * 0.08s);
  }
  .ranking:global(.in) .base {
    height: var(--h);
  }
  .ranking:global(.in) .degrau .avatar,
  .ranking:global(.in) .degrau b,
  .ranking:global(.in) .degrau small,
  .ranking:global(.in) li {
    opacity: 1;
    translate: 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .base {
      height: var(--h);
    }
    :global(.js) .degrau .avatar,
    :global(.js) .degrau b,
    :global(.js) .degrau small,
    :global(.js) li {
      opacity: 1;
      translate: none;
    }
  }
  .n {
    width: 18px;
    font-weight: 800;
    color: var(--muted);
  }
  li .avatar {
    width: 34px;
    height: 34px;
    font-size: 12px;
  }
  .nome {
    flex: 1;
    min-width: 0;
    line-height: 1.25;
  }
  .nome b {
    display: block;
    font-size: 15px;
  }
  .nome small {
    font-size: 12px;
    color: var(--muted);
  }
  .nome small.up {
    color: var(--up);
  }
  .nome small.down {
    color: var(--down);
  }
  .nome small.me {
    color: #b8ceff;
  }
</style>
