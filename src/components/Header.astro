---
import { signupUrl, mostrarPlanos } from '../config';
---

<header class="top">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Estugram, início">
      <img src="/estugram-logo-branca.png" width="528" height="92" alt="estugram" />
    </a>
    <nav aria-label="Seções" class="links">
      <a href="/#como-funciona">Como funciona</a>
      <a href="/#sala">Sala de estudo</a>
      <a href="/#organizacao">Organização</a>
      {mostrarPlanos && <a href="/#planos">Planos</a>}
      <a href="/#perguntas">Perguntas</a>
      <a href="/blog">Blog</a>
    </nav>
    <a class="btn btn-primary cta" href={signupUrl('header')}>Criar desafio</a>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background 0.5s ease,
      border-color 0.5s ease,
      backdrop-filter 0.5s ease;
  }
  /* Ganha fundo de vidro depois que a página sai do topo */
  .top:global(.rolou) {
    background: rgb(14 17 23 / 0.72);
    backdrop-filter: saturate(160%) blur(18px);
    -webkit-backdrop-filter: saturate(160%) blur(18px);
    border-bottom-color: rgb(255 255 255 / 0.06);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
  }
  /* Mesma marca do app (appestugram/public/img/estugram-logo-branca.png) */
  .brand img {
    height: 26px;
    width: auto;
    max-width: none;
  }
  .links {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .links a {
    position: relative;
    color: var(--muted-2);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    padding: 10px 12px;
    transition: color 0.3s ease;
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 5px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--blue);
    scale: 0 1;
    transform-origin: right;
    transition: scale 0.5s var(--ease-out);
  }
  .links a:hover {
    color: var(--text);
  }
  .links a:hover::after {
    scale: 1 1;
    transform-origin: left;
  }
  .cta {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .links {
      display: none;
    }
    .cta {
      margin-left: auto;
    }
  }
  @media (max-width: 420px) {
    .bar {
      gap: 12px;
    }
    .brand img {
      height: 22px;
    }
    .cta {
      padding: 0 14px;
    }
  }
</style>
