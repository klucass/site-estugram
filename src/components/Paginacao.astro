---
// Navegação entre as páginas do blog: anterior, números e próxima.
import type { Page } from 'astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const href = (n: number) => (n === 1 ? '/blog' : `/blog/${n}`);
const paginas = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---

{
  page.lastPage > 1 && (
    <nav class="paginacao" aria-label="Páginas do blog">
      {page.url.prev ? (
        <a class="passo" href={page.url.prev} rel="prev">
          <span aria-hidden="true">←</span> Anteriores
        </a>
      ) : (
        <span class="passo vazio" aria-hidden="true" />
      )}
      <ol>
        {paginas.map((n) => (
          <li>
            <a
              href={href(n)}
              class:list={{ atual: n === page.currentPage }}
              aria-current={n === page.currentPage ? 'page' : undefined}
              aria-label={`Página ${n}`}
            >
              {n}
            </a>
          </li>
        ))}
      </ol>
      {page.url.next ? (
        <a class="passo" href={page.url.next} rel="next">
          Mais artigos <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="passo vazio" aria-hidden="true" />
      )}
    </nav>
  )
}

<style>
  .paginacao {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-top: clamp(48px, 6vw, 72px);
    font-size: 15px;
    font-weight: 700;
  }
  ol {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ol a,
  .passo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 12px;
    color: var(--muted-2);
    text-decoration: none;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }
  ol a:hover,
  .passo:hover {
    background: var(--card);
    color: var(--text);
  }
  ol a.atual {
    background: var(--blue);
    color: var(--ink);
  }
  .passo {
    padding: 0 14px;
    justify-self: start;
  }
  .passo:last-child {
    justify-self: end;
  }
  .passo span {
    transition: translate 0.4s var(--ease-out);
  }
  .passo[rel='prev']:hover span {
    translate: -3px 0;
  }
  .passo[rel='next']:hover span {
    translate: 3px 0;
  }
  @media (max-width: 520px) {
    .paginacao {
      grid-template-columns: 1fr 1fr;
    }
    ol {
      grid-column: 1 / -1;
      grid-row: 1;
      justify-content: center;
    }
  }
</style>
